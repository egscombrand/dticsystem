18:["$","$L17","mengajukan-request",{"tutorial":{"id":"mengajukan-request","role":"pemohon","title":"Mengajukan Request","description":"Pelajari langkah memilih kategori, mengisi detail, melampirkan dokumen, dan mengirim pengajuan.","icon":"FilePlus2","estimatedMinutes":4,"startPage":"/","completion":{"kind":"start_request"},"steps":[{"title":"Memulai pengajuan","body":"Formulir pengajuan terdiri dari beberapa langkah: kategori, detail pekerjaan, tim & deadline, lalu tinjau sebelum kirim. Anda bisa mengisinya sambil mengikuti panduan ini."},{"title":"Memilih kategori","body":"Kategori menentukan tim yang akan menerima dan mengerjakan request Anda. Perhatikan kartu 'Graphic Design' yang berkedip sebagai contoh — Anda tetap bebas memilih kategori lain sesuai kebutuhan sungguhan.","target":{"page":"/","selector":"[data-tour=\"form-kategori\"]","wizardStep":0},"formDemo":{"pulseSelector":"[data-team-slug=\"graphic-design\"]"}},{"title":"Mengisi rincian pekerjaan","body":"Perhatikan field 'Nama', 'Departemen', 'Nomor WhatsApp', 'Judul Pekerjaan', dan 'Deskripsi Pekerjaan' — contoh pengisian lengkap akan diketik langsung pada field aslinya. Data contoh ini otomatis dikosongkan lagi setelah panduan ditutup.","target":{"page":"/","selector":"[data-tour=\"form-detail\"]","wizardStep":1},"formDemo":{"fields":[{"selector":"#requesterName","text":"Ani Lestari"},{"selector":"#department","text":"Marketing"},{"selector":"#requesterWhatsapp","text":"0812-3456-7890"},{"selector":"#title","text":"Desain Poster Seminar Lingkungan 2026"}],"richText":{"selector":"#brief","text":"Kami membutuhkan desain poster untuk Seminar Lingkungan 2026 yang akan diselenggarakan pada akhir tahun. Poster perlu menonjolkan tema keberlanjutan dengan warna hijau dominan, mencantumkan logo instansi, tanggal dan lokasi acara, serta judul pembicara utama. Target ukuran cetak A3 untuk dipasang di area kampus."}}},{"title":"Melampirkan dokumen","body":"Anda dapat melampirkan file referensi (gambar, dokumen) untuk membantu tim memahami hasil yang diinginkan — bersifat opsional. Lampiran ini tersimpan di sistem DTIC Nexus sendiri (bukan diunggah ke Google Drive); jika Anda punya folder referensi besar di Google Drive, tempelkan tautannya di field 'URL Google Drive' terpisah dengan izin berbagi yang sudah dibuka.","target":{"page":"/","selector":"[data-tour=\"form-lampiran\"]","wizardStep":1},"formDemo":{"file":{"fileName":"referensi-desain.png","fileSize":"2.4 MB"}}},{"title":"Tinjau Pengajuan Anda","body":"Tahap Tinjau digunakan untuk memeriksa kembali informasi pekerjaan, kategori, detail permintaan, dan dokumen pendukung sebelum pengajuan dikirim. Daftar 'Kelengkapan isian' di samping menunjukkan kelompok mana yang sudah dan belum terisi — bila ada yang belum lengkap atau keliru, gunakan tombol 'Kembali untuk Mengedit' untuk memperbaikinya sebelum mengirim.","target":{"page":"/","selector":"[data-tour=\"form-tinjau-ringkasan\"]","wizardStep":3}},{"title":"Memeriksa dan mengirim","body":"Pada langkah terakhir, periksa kembali seluruh data sebelum mengirim. Setelah dikirim, Anda akan menerima nomor order untuk melacak request ini. Tombol ini hanya didemonstrasikan di sini — pengajuan sungguhan baru dikirim setelah Anda mengisi data Anda sendiri.","target":{"page":"/","selector":"[data-tour=\"form-kirim\"]","wizardStep":3}}]}}]
19:["$","$L17","memantau-request",{"tutorial":{"id":"memantau-request","role":"pemohon","title":"Memantau Request","description":"Cara membuka riwayat, membaca status, dan melihat perkembangan pekerjaan Anda.","icon":"Search","estimatedMinutes":2,"startPage":"/riwayat","steps":[{"title":"Membuka riwayat request","body":"Masukkan nomor order yang Anda terima saat pengajuan untuk melihat status request Anda.","target":{"page":"/riwayat","selector":"[data-tour=\"riwayat-cari\"]"}},{"title":"Membaca status request","body":"Status request ditampilkan di bagian ini, mulai dari diterima, dikerjakan, hingga selesai — diperbarui langsung oleh tim DTIC.","target":{"page":"/riwayat","selector":"[data-tour=\"riwayat-status\"]"}},{"title":"Melihat detail perkembangan","body":"Lini masa di bawah status menampilkan riwayat setiap perubahan, lengkap dengan waktunya, sehingga Anda tahu sejauh mana pekerjaan berjalan.","target":{"page":"/riwayat","selector":"[data-tour=\"riwayat-timeline\"]"}}]}}]
1a:["$","$L17","memeriksa-hasil",{"tutorial":{"id":"memeriksa-hasil","role":"pemohon","title":"Memeriksa Hasil Pekerjaan","description":"Cara melihat file hasil, menyetujuinya, atau meminta revisi jika diperlukan.","icon":"CheckCircle2","estimatedMinutes":3,"startPage":"/riwayat","steps":[{"title":"File hasil yang diajukan","body":"Saat tim DTIC mengajukan hasil pekerjaan, file akan muncul di halaman riwayat request Anda (cari dulu nomor order Anda). Anda dapat melihat pratinjau atau mengunduhnya.","target":{"page":"/riwayat","selector":"[data-tour=\"riwayat-hasil\"]"}},{"title":"Menyetujui hasil","body":"Jika hasil sudah sesuai, gunakan tombol 'Setujui Hasil'. Tim DTIC akan menutup pekerjaan setelah persetujuan Anda.","target":{"page":"/riwayat","selector":"[data-tour=\"riwayat-setujui\"]"}},{"title":"Meminta revisi","body":"Jika hasil belum sesuai, gunakan tombol 'Minta Revisi' dan jelaskan bagian yang perlu diperbaiki. Tim DTIC akan menindaklanjuti catatan Anda.","target":{"page":"/riwayat","selector":"[data-tour=\"riwayat-revisi\"]"}}]}}]
1b:["$","$L17","bantuan-masukan",{"tutorial":{"id":"bantuan-masukan","role":"pemohon","title":"Bantuan dan Masukan","description":"Cara melaporkan kendala, mengirim saran, dan memantau laporan Anda.","icon":"MessageCircleQuestion","estimatedMinutes":2,"startPage":"/bantuan","steps":[{"title":"Jenis laporan","body":"Pilih jenis laporan yang sesuai: Bug/Kendala, Saran Perbaikan, Permintaan Fitur, atau Pertanyaan/Bantuan.","target":{"page":"/bantuan","selector":"[data-tour=\"bantuan-jenis\"]"}},{"title":"Mengisi laporan","body":"Tulis judul dan detail laporan Anda selengkap mungkin. Untuk laporan Bug/Kendala, sertakan tingkat dampaknya.","target":{"page":"/bantuan","selector":"[data-tour=\"bantuan-detail\"]"}},{"title":"Mengirim laporan","body":"Setelah dikirim, Anda akan menerima nomor tiket (format FB-2026-00001) untuk memantau laporan ini.","target":{"page":"/bantuan","selector":"[data-tour=\"bantuan-kirim\"]"}},{"title":"Memantau laporan","body":"Gunakan nomor tiket Anda di halaman 'Masukan Saya' untuk melihat status laporan dan membalas jika tim DTIC meminta informasi tambahan.","target":{"page":"/bantuan/riwayat","selector":"[data-tour=\"bantuan-lacak\"]"},"navigateTo":"/bantuan/riwayat"}]}}]
