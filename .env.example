# Salin ke .env.local dan isi. Jangan commit berkas berisi nilai asli.
# Semua variabel di bawah ini server-only (tanpa prefix NEXT_PUBLIC_).

# Postgres (Supabase Session pooler disarankan bila tidak ada IPv6)
# Pool per instance (default 1). Vercel: biarkan 1. Lokal boleh lebih besar, tetapi tetap kecil.
DB_POOL_MAX=1
DATABASE_URL=
# DB_POOL_MAX=5

# Storage: local (default) atau supabase
STORAGE_DRIVER=local
# LOCAL_STORAGE_DIR=.data/uploads
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=order-attachments

# Sesi login internal
# SESSION_TTL_HOURS=12
# SESSION_COOKIE_SECURE=true

# Bootstrap Super Admin (sekali, lalu hapus dari berkas)
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_NAME=
# BOOTSTRAP_ADMIN_PASSWORD=

# Rate limit pengajuan publik
# SUBMIT_RATE_LIMIT_MAX=5
# SUBMIT_RATE_LIMIT_WINDOW_SECONDS=600

# Notifikasi Telegram (opsional; lihat README → Notifikasi Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# DTIC_APP_URL=https://dtic.example.com
